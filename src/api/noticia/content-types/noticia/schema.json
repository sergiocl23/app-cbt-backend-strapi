{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Noticia"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "unique": false
    },
    "content": {
      "type": "text",
      "required": true,
      "maxLength": 1000000
    },
    "summary": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "mainImage": {
      "type": "string",
      "required": false
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": false
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "noticias",
      "configurable": true
    },
    "pais": {
      "type": "enumeration",
      "enum": [
        "chile",
        "paraguay",
        "brasil",
        "argentina",
        "mundo"
      ],
      "required": true,
      "default": "chile",
      "configurable": true
    },
    "sourceUrl": {
      "type": "text",
      "unique": true,
      "required": true
    },
    "sourceName": {
      "type": "string",
      "required": true
    },
    "scrapedContent": {
      "type": "text",
      "private": true
    },
    "articleType": {
      "type": "enumeration",
      "enum": [
        "regular",
        "topicFeatured",
        "topicSmall"
      ],
      "default": "regular",
      "required": true
    },
    "publishedAt": {
      "type": "datetime"
    },
    "articleDate": {
      "type": "datetime",
      "required": true
    }
  }
}
