{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Noticia",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "unique": false
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "unique": false
    },
    "content": {
      "type": "text",
      "maxLength": 1000000
    },
    "summary": {
      "type": "text",
      "maxLength": 500
    },
    "mainImage": {
      "type": "string",
      "required": false
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/svg+xml",
        "image/tiff",
        "image/x-icon"
      ]
    },
    "additionalImages": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/svg+xml",
        "image/tiff",
        "image/x-icon"
      ],
      "max": 5
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": false
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "noticias"
    },
    "pais": {
      "type": "enumeration",
      "enum": [
        "chile",
        "paraguay",
        "brasil",
        "argentina",
        "mundo"
      ],
      "default": "chile",
      "configurable": true
    },
    "sourceUrl": {
      "type": "text"
    },
    "sourceName": {
      "type": "string"
    },
    "articleType": {
      "type": "enumeration",
      "enum": [
        "regular",
        "destacada",
        "minimal"
      ],
      "default": "regular"
    },
    "relevanceScore": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "description": "Puntuación de relevancia para artículos minimales (0-100)"
    },
    "publishedAt": {
      "type": "datetime"
    },
    "articleDate": {
      "type": "datetime"
    },
    "manualCreation": {
      "type": "boolean",
      "default": false
    }
  }
}
