    "completedJobs": {
      "type": "integer",
      "default": 0
    },
    "failedJobs": {
      "type": "integer",
      "default": 0
    },
    "jobs": {
      "type": "component",
      "component": "newsletter.queue-job",
      "repeatable": true
    }
  }
